{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sua-palavra-diaria/esquemas/content.schema.json",
  "title": "Conteudo de uma run do Verse Card V5",
  "type": "object",
  "required": [
    "run_id",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
      "description": "AAAA-MM-DD-identificador. Identifica a publicação e seus relatórios."
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": [
        "tipo",
        "formato"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "capa",
            "interno"
          ]
        },
        "formato": {
          "enum": [
            "feed",
            "story"
          ]
        },
        "livro": {
          "type": "string",
          "minLength": 1
        },
        "referencia": {
          "type": "string"
        },
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "foto": {
          "type": "string",
          "format": "uri"
        },
        "foto_alt": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "marca_dagua": {
          "type": "boolean"
        },
        "paragrafos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versiculos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "linhas"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "linhas": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "capa"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "required": [
              "livro",
              "versiculos"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "interno"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "required": [
              "titulo",
              "paragrafos"
            ]
          }
        },
        {
          "if": {
            "required": [
              "foto"
            ]
          },
          "then": {
            "required": [
              "foto_alt"
            ]
          }
        }
      ]
    }
  }
}
